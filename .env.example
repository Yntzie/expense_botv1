# Token bot Telegram, didapat dari @BotFather di Telegram
BOT_TOKEN=isi_token_bot_kamu_disini

# Port untuk dashboard web
PORT=3000

# WAJIB diisi setelah kamu tahu chat_id kamu sendiri (kirim /start ke bot untuk lihat chat_id-nya).
# Boleh diisi lebih dari satu, pisahkan dengan koma, misal: 111111,222222
# Kalau dikosongkan, bot bisa dipakai SIAPA SAJA yang menemukan username bot kamu.
ALLOWED_CHAT_IDS=

# WAJIB diisi sebelum di-hosting ke internet. Ini jadi password dashboard web (Basic Auth).
# Kalau dikosongkan, dashboard bisa diakses siapa saja yang tahu URL-nya, tanpa password.
DASHBOARD_KEY=ubah_ini_jadi_password_kamu
